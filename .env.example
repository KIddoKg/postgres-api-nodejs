# PostgreSQL
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=vn_provinces
POSTGRES_USER=admin
POSTGRES_PASSWORD=secret123

# SQL Server (điền thông tin server cũ của bạn)
MSSQL_HOST=your-sqlserver-host
MSSQL_PORT=1433
MSSQL_DB=your_database_name
MSSQL_USER=sa
MSSQL_PASSWORD=your_password
# Nếu SQL Server dùng Windows Auth hoặc Azure thì set MSSQL_ENCRYPT=true
MSSQL_ENCRYPT=false
MSSQL_TRUST_CERT=true

# DB Mode: postgres | sqlserver | dual
# - postgres   : chỉ dùng PostgreSQL (cuối quá trình migrate)
# - sqlserver  : chỉ dùng SQL Server (trước khi migrate)
# - dual       : đọc Postgres trước, fallback SQL Server (trong quá trình migrate)
DB_MODE=dual

# API
API_PORT=3000
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
NODE_ENV=development

# Web
WEB_PORT=5173

# Admin account (dùng khi seed)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@123
